#!/bin/sh
##
# Check that a version directory's example tmux.conf loads without errors.
#
# This copies `sources/<version>` into a temporary
# `~/.config/tmux`, starts a separate tmux server on its own socket in the
# same temporary directory, with
# no config, then sources the example `tmux.conf`, which sources the other
# files, and reports any errors. It doesn't touch any tmux server you are
# using, or your own config files.
#
# The example `tmux.conf` sources platform-specific files only for the
# running platform, and via `if-shell`, which older tmux runs without
# waiting, so errors in those files might not be reported. So then this
# also sources every platform-specific file directly, on any platform.
#
# Usage:
#
#     bin/check            check the directory for the installed tmux
#     bin/check 3.8        check the directory for tmux 3.8
#
# The check is meaningful only for the directory that matches the
# installed tmux, because older directories use syntax that newer tmux
# no longer accepts.
#
# Exit status is 0 if the config loads cleanly, and 1 otherwise.
##

set -eu

dir=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
installed=$(tmux -V | sed -E 's/^[^0-9]*([0-9]+\.[0-9]+).*/\1/')
version=${1:-$installed}
src="$dir/sources/$version"

if [ ! -d "$src" ]; then
  echo "error: no directory for tmux $version: $src"
  exit 1
fi
if [ "$version" != "$installed" ]; then
  echo "warning: checking tmux $version files with tmux $installed"
fi

tmp=$(mktemp -d)
cleanup() {
  HOME="$tmp" tmux -S "$tmp/tmux.sock" kill-server 2>/dev/null || true
  rm -rf "$tmp"
}
trap cleanup EXIT

mkdir -p "$tmp/.config/tmux"
cp -R "$src/." "$tmp/.config/tmux/"

echo "$(tmux -V), files for tmux $version"
HOME="$tmp" tmux -S "$tmp/tmux.sock" -f /dev/null new-session -d

# Source one file, and print any errors. Return 1 if there are errors.
check_file() {
  rel=$1
  status=0
  output=$(HOME="$tmp" tmux -S "$tmp/tmux.sock" source-file "$tmp/.config/tmux/$rel" 2>&1) || status=$?
  # tmux 1.9 prints "set option: name -> value" for each option that a
  # client command sets. These are information, not errors, so ignore them.
  errors=$(printf '%s\n' "$output" | grep -v -e '^set option: ' -e '^$' || true)
  if [ "$status" -eq 0 ] && [ -z "$errors" ]; then
    echo "ok: sources/$version/$rel loads without errors"
  else
    [ -n "$errors" ] && echo "$errors"
    echo "error: sources/$version/$rel has errors"
    return 1
  fi
}

failed=0
check_file tmux.conf || failed=1
for path in "$tmp/.config/tmux"/platform-specific/*/*.conf; do
  [ -e "$path" ] || continue
  check_file "${path#"$tmp/.config/tmux/"}" || failed=1
done
exit "$failed"
